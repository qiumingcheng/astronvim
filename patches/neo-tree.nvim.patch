+---Check only the paths being displayed, without synchronously walking the worktree.
+---Tracked paths are intentionally excluded by check-ignore's default index handling.
+---@param worktree_root string
+---@param paths string[] Absolute paths; NUL stdin preserves spaces and newlines.
+---@param on_parsed fun(ignored_paths: string[]?, err: string?)
+M.ignored_paths_job = function(worktree_root, paths, on_parsed)
+  -- Git does not traverse directory symlinks. check-ignore rejects such descendants
+  -- instead of merely omitting them like ls-files, so exclude them before batching.
+  local linked_parents = {}
+  local function beyond_link(parent)
+    if not parent or parent == worktree_root or not utils.is_subpath(worktree_root, parent, true) then
+      return false
+    end
+    if linked_parents[parent] == nil then
+      local stat = (vim.uv or vim.loop).fs_lstat(parent)
+      linked_parents[parent] = (stat and stat.type == "link") or beyond_link(utils.split_path(parent))
+    end
+    return linked_parents[parent]
+  end
+  local query_paths = {}
+  for _, path in ipairs(paths) do
+    if not beyond_link(utils.split_path(path)) then
+      query_paths[#query_paths + 1] = path
+    end
+  end
+  if #query_paths == 0 then
+    on_parsed({})
+    return
+  end
+  local cmd = git_cmd.with_args({ "-C", worktree_root, "check-ignore", "--stdin", "-z" })
+  -- check-ignore accepts literal pathnames, but rejects the global pathspec-magic
+  -- flag used by ls-files/status. Absolute NUL-delimited input needs no quoting.
+  for i, arg in ipairs(cmd) do
+    if arg == "--literal-pathspecs" then
+      cmd[i] = "--no-literal-pathspecs"
+      break
+    end
+  end
+  local ok, job = pcall(vim.system, cmd, {
+    stdin = table.concat(query_paths, "\000") .. "\000",
+    text = false,
+  }, function(result)
+    vim.schedule(function()
+      -- Exit 1 means that none of the supplied paths is ignored.
+      if (result.code ~= 0 and result.code ~= 1) or result.signal ~= 0 then
+        on_parsed(nil, string.format(
+          "git check-ignore failed for %s (code %s, signal %s): %s",
+          worktree_root, tostring(result.code), tostring(result.signal), result.stderr or ""
+        ))
+        return
+      end
+      local ignored_paths = {}
+      for path in utils.gsplit_plain(result.stdout or "", "\000") do
+        if #path > 0 then
+          ignored_paths[#ignored_paths + 1] = utils.normalize_path(path)
+        end
+      end
+      on_parsed(ignored_paths)
+    end)
+  end)
+  if not ok then
+    vim.schedule(function()
+      on_parsed(nil, "git check-ignore could not start for " .. worktree_root .. ": " .. tostring(job))
+    end)
+    return
+  end
+  return job
+end
+
 ---@param context neotree.git.JobContext
 ---@param on_parsed fun(new_status: string[]?, err: string?)
 M.ignored_job = function(context, on_parsed)

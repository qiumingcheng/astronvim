--- /dev/null
+++ b/lua/dapui/client/reads.lua
@@ -0,0 +1,160 @@
+-- Reuse read-only responses within one pause. Never cache evaluation commands.
+local dap, nio = require("dap"), require("nio")
+local M = {}
+local serial = 0
+
+local function key(command, args)
+  if command ~= "variables" and command ~= "stackTrace" then return end
+  args = vim.deepcopy(args or {})
+  if command == "stackTrace" then
+    args.startFrame = args.startFrame or 0
+    args.levels = args.levels or 0
+  end
+  local function stable(value)
+    if type(value) ~= "table" then return vim.json.encode(value) end
+    local parts = {}
+    for _, name in ipairs(vim.tbl_keys(value)) do parts[#parts + 1] = name end
+    table.sort(parts)
+    for i, name in ipairs(parts) do parts[i] = vim.json.encode(name) .. ":" .. stable(value[name]) end
+    return "{" .. table.concat(parts, ",") .. "}"
+  end
+  return command .. stable(args)
+end
+
+function M.new(session_factory)
+  serial = serial + 1
+  local id = "portable_reads_" .. serial
+  local states, hooks = setmetatable({}, { __mode = "k" }), {}
+  local function state(s)
+    if not states[s] then states[s] = { epoch = 0, floor = s.seq, entries = {}, scope_frame = nil } end
+    return states[s]
+  end
+  local function finish(entry, result)
+    if not entry.future.is_set() then entry.future.set(result) end
+  end
+  local function reset(s, keep_scopes)
+    local st = state(s)
+    st.epoch, st.floor = st.epoch + 1, s.seq
+    local old = st.entries
+    st.entries = {}
+    if not keep_scopes then st.scope_frame = nil end
+    -- Core's eager scope values must also be invalidated after a variable edit.
+    for _, scope in ipairs((s.current_frame or {}).scopes or {}) do scope.variables = nil end
+    for _, entry in pairs(old) do finish(entry, { stale = true }) end
+  end
+  local function listen(phase, event, fn)
+    dap.listeners[phase][event][id] = fn
+    hooks[#hooks + 1] = { phase, event }
+  end
+  for _, event in ipairs({ "initialized", "stopped", "continued", "terminated", "exited" }) do
+    listen("before", "event_" .. event, function(s) reset(s, false) end)
+  end
+  for _, command in ipairs({ "next", "stepIn", "stepOut", "continue", "stepBack", "reverseContinue", "restartFrame" }) do
+    listen("before", command, function(s, err)
+      -- GDB may omit continued. A late response must not clear a newer pause.
+      if not err and not s.stopped_thread_id then reset(s, false) end
+    end)
+  end
+  for _, command in ipairs({ "setVariable", "setExpression", "writeMemory" }) do
+    listen("before", command, function(s) reset(s, true) end)
+  end
+  listen("before", "evaluate", function(s, _, _, args)
+    if args and args.context == "repl" then reset(s, true) end
+  end)
+  listen("before", "event_invalidated", function(s) reset(s, true) end)
+  listen("before", "disconnect", function(s) reset(s, false) end)
+
+  local cache = {}
+  function cache.valid_response(s, command, args, seq)
+    if command ~= "scopes" and command ~= "variables" and command ~= "stackTrace" then return true end
+    if not s or s.closed then return false end
+    local st = state(s)
+    if (command == "scopes" or command == "variables" or command == "stackTrace") and seq < st.floor then return false end
+    if command == "scopes" then
+      return s.stopped_thread_id ~= nil and s.current_frame and args.frameId == s.current_frame.id
+    end
+    return true
+  end
+  listen("before", "scopes", function(s, err, body, args, seq)
+    if not err and body and cache.valid_response(s, "scopes", args, seq) then state(s).scope_frame = s.current_frame end
+  end)
+  -- Join the core's in-flight eager variables request instead of sending a copy.
+  for _, command in ipairs({ "variables", "stackTrace" }) do
+    listen("after", command, function(s, err, body, args, seq)
+      local st = state(s)
+      local entry = st.entries[key(command, args)]
+      if entry and entry.seq == seq and seq >= st.floor then
+        finish(entry, { err = err, body = body })
+        if err then st.entries[key(command, args)] = nil end
+      end
+    end)
+  end
+
+  function cache.token()
+    local s = session_factory()
+    return s and { session = s, epoch = state(s).epoch, frame = s.current_frame } or nil
+  end
+  function cache.current(token)
+    local s = session_factory()
+    if not token then return s == nil end
+    return s == token.session and not s.closed and s.stopped_thread_id ~= nil
+      and state(s).epoch == token.epoch and s.current_frame == token.frame
+  end
+  local function same_pause(token)
+    local s = session_factory()
+    return s == token.session and not s.closed and s.stopped_thread_id ~= nil and state(s).epoch == token.epoch
+  end
+  function cache.ready()
+    local s = session_factory()
+    return s and not s.closed and s.stopped_thread_id and s.current_frame
+      and state(s).scope_frame == s.current_frame and s.current_frame.scopes ~= nil
+  end
+  function cache.request(command, args, raw)
+    local k = key(command, args)
+    local s = session_factory()
+    if not k or not s then return raw(command, args) end
+    local st = state(s)
+    if s.closed or not s.stopped_thread_id then error("Debug frame is no longer paused") end
+    local token = cache.token()
+    local entry = st.entries[k]
+    if not entry then
+      -- nvim-dap already reads the current frame's scopes. Reuse their results.
+      if command == "variables" and not args.filter and not args.start and not args.count and not args.format then
+        for _, scope in ipairs((s.current_frame or {}).scopes or {}) do
+          if scope.variablesReference == args.variablesReference and scope.variables then
+            return nil, { variables = scope.variables }
+          end
+        end
+      end
+      entry = { future = nio.control.future() }
+      st.entries[k] = entry
+      for seq, pending in pairs(s.message_requests) do
+        -- The core only populates this table with arguments. Distinguish the
+        -- two read commands by their mandatory, disjoint argument fields.
+        local is_read = (command == "variables" and pending.variablesReference ~= nil)
+          or (command == "stackTrace" and pending.threadId ~= nil and pending.startFrame ~= nil)
+        if seq >= st.floor and is_read and key(command, pending) == k then entry.seq = seq; break end
+      end
+      if not entry.seq then
+        local ok, err, body = pcall(raw, command, args)
+        if not ok then
+          st.entries[k] = nil
+          finish(entry, { failure = err })
+        elseif same_pause(token) then
+          finish(entry, { err = err, body = body })
+          if err then st.entries[k] = nil end
+        else finish(entry, { stale = true }) end
+      end
+    end
+    local result = entry.future.wait()
+    if result.stale or not same_pause(token) then error("Debug frame changed while reading") end
+    if result.failure then error(result.failure) end
+    return result.err, result.body
+  end
+  function cache.shutdown()
+    for s in pairs(states) do reset(s, false) end
+    for _, hook in ipairs(hooks) do dap.listeners[hook[1]][hook[2]][id] = nil end
+  end
+  return cache
+end
+return M
